# Copy to .env and fill in. `docker compose` reads .env automatically.

# Postgres password (also used by backend's connection string)
POSTGRES_PASSWORD=postgres

# JWT signing secret — long random string, required, backend refuses to start without it
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Origin the backend's CORS policy allows (the frontend's public URL)
FRONTEND_ORIGIN=http://localhost:4200

# Apply EF Core migrations automatically on backend startup.
# Default false: current migration is starter scaffold (Identity + Product), not your model yet.
# Set true once you have real migrations you want auto-applied.
APPLY_MIGRATIONS_ON_STARTUP=false
